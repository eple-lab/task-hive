# .env로 복사해서 쓴다. .env는 Git에 올리지 않는다.
#
# 어떤 DB를 쓸지는 아래 Supabase 두 줄로 정해진다.
#   - 둘 다 비워 두면 → SQLite 모드: 내 컴퓨터의 data/todo.db에 저장, 로그인 없음 (길 A)
#   - 둘 다 채우면   → Supabase 모드: 클라우드 DB에 저장, 회원가입·로그인, RLS (길 B)
#   - 하나만 채우면  → 설정 실수로 보고 서버가 켜지지 않는다
# 서버를 켜면 첫 줄에 어느 모드인지 나온다. 예) TODO: http://localhost:3000 (SQLite: data/todo.db)

PORT=3000

# --- SQLite 모드 (선택) ---
# DB 파일 위치. 비워 두면 data/todo.db
DB_PATH=

# --- Supabase 모드 ---
# Supabase 대시보드 → Connect 또는 Project Settings → API
# Connect 화면이 NEXT_PUBLIC_SUPABASE_URL처럼 보여 주면 앞의 NEXT_PUBLIC_만 빼고 넣는다
#SUPABASE_URL=https://<프로젝트ID>.supabase.co
SUPABASE_URL=
# "Publishable key"(sb_publishable_...). 예전 프로젝트라면 SUPABASE_ANON_KEY에 anon key를 넣어도 된다.
# service_role / secret key는 RLS를 무시하는 관리자 키라서 절대 넣지 않는다.
SUPABASE_PUBLISHABLE_KEY=

# (선택) RLS 확인 스크립트(npm run check:rls)용 테스트 계정 두 개. Supabase 모드에서만 쓴다
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=
