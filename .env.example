# ============================================================================
# Task Hive 환경변수 예시
#
# 쓰는 법
#   1) 이 파일을 .env 로 복사한다.
#   2) 값을 채운다. 로컬에서는 전부 비워 두어도 손님 모드로 돌아간다.
#   3) .env 는 절대 Git에 올리지 않는다 (.gitignore에 있다).
#   4) 운영(Render)에서는 .env 파일 대신 Render 화면의 환경변수에 넣는다.
#
# 표기
#   [필수-운영]  APP_ENV=production 일 때 비어 있으면 서버가 켜지지 않는다.
#   [선택]       비워 두면 기본값을 쓴다.
#   [비밀]       남에게 보이면 안 되는 값. 로컬과 운영에서 서로 다른 값을 쓴다.
# ============================================================================


# ── 1. 실행 환경 ─────────────────────────────────────────────────────────────

# development | production
#   development: 비밀값이 비어 있으면 실행할 때마다 임시값을 만든다.
#                쿠키에 Secure를 붙이지 않는다(http://localhost에서 동작해야 하므로).
#   production : 비밀값이 하나라도 없으면 시작을 거부한다. 쿠키에 Secure를 붙인다.
APP_ENV=development

# 브라우저가 접속하는 주소. 끝에 / 를 붙이지 않는다.
#   로컬 : http://localhost:8000
#   운영 : https://<서비스이름>.onrender.com
# CSRF 검사(Origin 확인)와 구글 로그인 돌아올 주소에 쓴다.
PUBLIC_BASE_URL=http://localhost:8000


# ── 2. 비밀값 ────────────────────────────────────────────────────────────────

# [필수-운영][비밀] 세션 쿠키를 암호화하는 키 (Fernet 키).
#   쿠키 안에 손님 세션 ID, 이름, Colab 주소, 접속 키가 들어가므로 서명만으로는 부족하다.
#   만드는 법: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   바꾸면: 모든 사용자의 세션이 끊긴다(다시 시작하면 된다).
SESSION_SECRET=

# [필수-운영][비밀] 태스크 제목과 구글 토큰을 DB에 넣기 전에 암호화하는 키 (Fernet 키).
#   만드는 법: 위와 같다. SESSION_SECRET과 다른 값을 쓴다.
#   바꾸면: 이미 저장된 제목·토큰을 읽지 못한다. 바꾸기 전에 옮길 방법을 정한다.
DATA_ENC_KEY=

# [필수-운영][비밀] 구글 사용자 ID와 손님 세션 ID를 가릴 때(HMAC) 쓰는 키.
#   만드는 법: python -c "import secrets; print(secrets.token_hex(32))"
#   바꾸면: 기존 구글 사용자를 찾지 못한다(새 사용자로 취급).
SUB_HASH_KEY=


# ── 3. 데이터베이스 ──────────────────────────────────────────────────────────

# [선택][비밀] Neon Postgres 연결 문자열. (결정 D-26)
#   비우면  : 메모리 저장소를 쓴다. 서버를 끄면 데이터가 사라진다. 로컬 개발·테스트용.
#   채우면  : Neon을 쓴다. 로컬에서는 운영과 다른 "개발 브랜치"의 주소를 넣는다.
#   형식    : postgresql://<사용자>:<비밀번호>@<호스트>/<DB이름>?sslmode=require
#   주의    : Neon 무료는 5분 동안 안 쓰면 멈춰서 첫 요청이 느리고, 복구 가능 기간이 6시간이다.
DATABASE_URL=


# ── 4. 벌집 ─────────────────────────────────────────────────────────────────

# [선택] 벌집의 최대 고리(단) 수. 기본 3. (결정 D-24)
#   칸 수를 직접 받지 않고 고리 수를 받는 이유: 벌집이 둥근 모양을 유지하려면
#   고리 단위로 늘어나야 한다. 칸 수 = 1 + 3 × n × (n + 1)
#
#     고리 수   칸 수   메모
#        1        7     가장 작은 둥근 벌집 (가운데 1 + 둘레 6)
#        2       19
#        3       37     기본값. 초안의 "최대 3단"
#        4       61     칸이 작아져 휴대폰에서는 제목이 잘 안 보인다
#        5       91     권하지 않는다
#
#   한도를 넘겨 등록하면 서버가 거절(409)하고, 화면이 "완료한 태스크를 보관함으로
#   옮길까요?"라고 안내한다. 보관함으로 옮긴 태스크는 칸을 차지하지 않는다.
#   값을 줄였는데 이미 그보다 많은 태스크가 있으면: 기존 태스크는 그대로 두고
#   새 등록만 막는다. 허용 범위 1~6. 범위를 벗어나면 서버가 켜지지 않는다.
HIVE_MAX_RINGS=3


# ── 5. 데이터 보관 기간 ──────────────────────────────────────────────────────

# [선택] 손님(로그인 안 한 사용자)의 데이터를 마지막 활동 뒤 몇 시간 보관할지. 기본 24. (결정 D-07)
#   내려받기를 하면 이 시간과 상관없이 바로 지운다.
GUEST_TTL_HOURS=24

# [선택] 완료한 태스크를 완료 뒤 며칠 보관할지. 기본 90. (결정 D-23)
DONE_TASK_TTL_DAYS=90

# [선택] 로그인 세션이 유지되는 시간. 기본 8. (eple 확정, honey-voice-log와 같다)
SESSION_HOURS=8

# [선택] 성능 지표(숫자만)를 며칠 보관할지. 기본 30.
METRICS_TTL_DAYS=30


# ── 6. LLM 서버(업스트림) 주소 검사 ──────────────────────────────────────────
# 사용자가 화면에 넣는 Colab(ngrok) 주소를 서버가 그대로 부르기 때문에,
# 아무 주소나 받으면 서버가 내부망을 찌르게 된다(SSRF). 아래 값으로 막는다. (결정 D-04)

# [선택] 허용하는 주소의 끝부분. 쉼표로 구분. 앞에 점을 붙인다.
#   기본값은 ngrok 무료 도메인 2종이다. 유료 ngrok 도메인을 쓰면 여기에 더한다.
UPSTREAM_ALLOWED_HOST_SUFFIXES=.ngrok-free.app,.ngrok-free.dev

# [선택] true면 http://localhost, http://127.0.0.1 주소도 받는다. 기본 false.
#   내 PC의 Ollama로 실험할 때만 켠다. APP_ENV=production 에서는 true로 둘 수 없다
#   (서버가 켜지지 않는다).
UPSTREAM_ALLOW_LOCALHOST=false

# [선택] 업스트림 연결·응답을 기다리는 시간(초).
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=120


# ── 7. 구글 로그인 (2단계. 비워 두면 구글 버튼이 숨겨지고 손님 모드만 된다) ───

# [선택][비밀] Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
#   승인된 리디렉션 URI: <PUBLIC_BASE_URL>/auth/callback
#   요청하는 권한: 로그인할 때는 openid만. 사용자가 기능 "연결"을 누를 때
#     drive.file (일기 저장, 태스크 시트) / calendar.events.owned.readonly (캘린더)
#   를 따로 요청한다. (결정 D-14, D-15, D-16)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [선택] 구글 토큰을 어떻게 둘지. access_only | refresh  기본 access_only. (결정 D-19, D-27)
#
#   access_only : 약 1시간짜리 토큰만 받는다. 만료되면 사용자가 "구글 다시 연결"을 누른다.
#                 서버에 오래 가는 토큰이 없어 더 안전하다. 기본값이고 권장값이다.
#   refresh     : 오래 가는 토큰(refresh token)을 받아 암호화해 DB에 둔다.
#                 다시 묻지 않고 일기 저장·캘린더 읽기가 된다.
#                 주의 1) 서버 DB에 오래 가는 토큰이 남는다. DATA_ENC_KEY 관리가 더 중요해진다.
#                 주의 2) 구글 앱이 "테스트" 상태면 이 토큰도 7일 뒤 만료된다.
#                         (docs/checks/google-oauth-7day-expiry.md)
#
#   다시 연결할 때의 보안 (두 방식 공통, 보안 최대화):
#     - 저절로 다시 로그인하지 않는다. 화면 오른쪽 위에 남은 시간을 보여 주고,
#       사용자가 "연장"을 눌렀을 때만 조용한 재로그인(prompt=none)을 팝업 창에서 시도한다.
#       구글이 화면이 필요하다고 답하면 그때 계정 선택 화면을 띄운다. (D-27, 2026-11-17 결정)
#     - 처음 로그인과 계정 선택이 필요할 때는 계정 선택 화면(prompt=select_account)을 보여 준다.
#     - state, nonce, PKCE를 매번 새로 만든다.
#     - 다시 연결하면 세션 ID를 새로 만든다.
GOOGLE_TOKEN_MODE=access_only


# ── 8. 관리자 (성능 검토 화면) ───────────────────────────────────────────────

# [선택] /admin 을 볼 수 있는 구글 계정 목록. 쉼표로 구분.
#   이메일이 아니라 "가린 ID"(구글 사용자 ID를 SUB_HASH_KEY로 HMAC한 값)를 넣는다.
#   비우면 관리자가 없다. APP_ENV=development 에서는 로그인 없이 열린다.
ADMIN_SUB_HASHES=


# ── 9. 날씨 ─────────────────────────────────────────────────────────────────

# [선택] 사용자가 도시를 고르기 전에 쓰는 기본 도시. (결정 D-25)
#   Open-Meteo를 쓰므로 API 키가 필요 없다. 브라우저 위치 권한은 쓰지 않는다.
WEATHER_DEFAULT_CITY=서울


# ── 10. 요청 제한 (남용 방지) ────────────────────────────────────────────────
# 1분 동안 보낼 수 있는 횟수(최근 60초를 미끄러지며 센다). 서버 메모리에 기록하므로
# 서버가 재시작되면 초기화된다. Render 무료는 외부로 너무 많은 요청을 내면 정지될 수 있다.
# 분당 방식으로 통일했다(eple 결정, 2026-11-17). 짧은 시간에 몰리는 요청을 막는 데 낫다.
#   모두 "종류 + 접속 IP"로 센다(프록시 뒤에서는 X-Forwarded-For의 맨 뒤 값). 세션으로는 세지 않는다.
#   CHAT          : 대화와 일기 요약(/api/chat, /api/diary/*). Colab으로 중계되는 비싼 요청이다.
#   EXTRACT       : 할 일 추출(/api/extract).
#   GENERAL       : 그 밖의 모든 /api 요청.
#   GUEST_START   : 손님 시작(POST /api/guest).
#   말하기(TTS) 제한은 2단계에 TTS를 붙일 때 더한다.

RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_EXTRACT_PER_MIN=30
RATE_LIMIT_GENERAL_PER_MIN=240
RATE_LIMIT_GUEST_START_PER_MIN=5

# 입력 크기 제한
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_MESSAGES=40
MAX_TITLE_CHARS=200


# ── 11. 화면 개발 (frontend/.env.local 에 넣는 값. 서버 .env 가 아니다) ───────
# VITE_USE_MOCK=1   백엔드 없이 가짜 응답으로 화면만 볼 때
